{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "covid19-reporting-Learn-adf"
		},
		"ds_blob_covid19reportingsa_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ds_blob_covid19reportingsa'"
		},
		"ls_adl_covid19reportingdl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adl_covid19reportingdl'"
		},
		"ls_adl_covid19reportingdl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://covid19reportinglearndl.dfs.core.windows.net/"
		},
		"ls_github_covid_raw_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"tr_injest_hospitald_admission_data_properties_pl_ingest_ecdc_data_parameters_sourcerelatveURL": {
			"type": "string",
			"defaultValue": "/RaghuramRamesh27/Covid19_Project/main/hospital_admissions.csv"
		},
		"tr_injest_hospitald_admission_data_properties_pl_ingest_ecdc_data_parameters_sinkfilename": {
			"type": "string",
			"defaultValue": "hospital_admissions.csv"
		},
		"tr_injest_population_data_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/f94d5077-a26c-4b5b-85c5-6c7020d12312/resourceGroups/covid-reporting-rg/providers/Microsoft.Storage/storageAccounts/covid19reportinglearn"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "covid19-reporting-Learn-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ds_blob_covid19reportingsa_connectionString": {
						"value": "[parameters('ds_blob_covid19reportingsa_connectionString')]"
					},
					"ls_adl_covid19reportingdl_accountKey": {
						"value": "[parameters('ls_adl_covid19reportingdl_accountKey')]"
					},
					"ls_adl_covid19reportingdl_properties_typeProperties_url": {
						"value": "[parameters('ls_adl_covid19reportingdl_properties_typeProperties_url')]"
					},
					"ls_github_covid_raw_properties_typeProperties_url": {
						"value": "[parameters('ls_github_covid_raw_properties_typeProperties_url')]"
					},
					"tr_injest_hospitald_admission_data_properties_pl_ingest_ecdc_data_parameters_sourcerelatveURL": {
						"value": "[parameters('tr_injest_hospitald_admission_data_properties_pl_ingest_ecdc_data_parameters_sourcerelatveURL')]"
					},
					"tr_injest_hospitald_admission_data_properties_pl_ingest_ecdc_data_parameters_sinkfilename": {
						"value": "[parameters('tr_injest_hospitald_admission_data_properties_pl_ingest_ecdc_data_parameters_sinkfilename')]"
					},
					"tr_injest_population_data_properties_typeProperties_scope": {
						"value": "[parameters('tr_injest_population_data_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}